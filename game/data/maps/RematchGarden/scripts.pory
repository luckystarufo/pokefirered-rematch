    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_MR_MIME)) {
        playmoncry(SPECIES_MR_MIME, CRY_MODE_NORMAL)
        msgbox(format("MR. MIME is leaning on its invisible wall now, completely at ease."))
        waitmoncry
        release
        end
    }
    setflag(FLAG_REMATCH_TALKED_MR_MIME)
    playmoncry(SPECIES_MR_MIME, CRY_MODE_NORMAL)
    msgbox(format("MR. MIME: Bari! Bari!\pIt's pressing both hands against an invisible wall... right between you and the door."))
    waitmoncry
    release
    end
}

// ---------------------------------------------------------------- the two couples in the meadow
// LEX & NYA (Sevault Canyon) and JED & LEA (Route 16) fell out years ago over a double battle and
// who had the rarer POKéMON. Tonight they finally made up.
script Rematch_Garden_EventScript_Lex {
    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_LEX)) {
        msgbox(format("LEX: Fishing next week. With JED. If you'd told me that years ago..."))
        release
        end
    }
    setflag(FLAG_REMATCH_TALKED_LEX)
    msgbox(format("LEX: Oh, hey. You're the one who beat NYA and me back in the canyon.\pNobody had managed that in years. We talked about it for a month."))
    msgbox(format("JED and I haven't spoken since a double battle on ROUTE 16 went... badly. Very badly.\pTonight NYA marched us over here and made us shake hands."))
    msgbox(format("Turns out we both cut out the same POKéMON magazine column. The same one! Since we were kids.\pFeels kind of silly now."))
    release
    end
}
script Rematch_Garden_EventScript_Nya {
    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_NYA)) {
        msgbox(format("NYA: A tie. Officially. Don't let either of them tell you otherwise."))
        release
        end
    }
    setflag(FLAG_REMATCH_TALKED_NYA)
    msgbox(format("NYA: Don't mind the boys. They sulked for ages over whose POKéMON were rarer."))
    msgbox(format("Our MILTANK came all the way from JOHTO. LEA's NINETALES has the softest tails in KANTO.\pWe've agreed it's a tie. Officially."))
    msgbox(format("Oh! Take some of this before the boys drink it all.\pFresh from our MILTANK. Best in two regions!"))
    giveitem(ITEM_MOOMOO_MILK, 3)
    release
    end
}
script Rematch_Garden_EventScript_Jed {
    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_JED)) {
        msgbox(format("JED: For the record, RAPIDASH did NOT false-start."))
        release
        end
    }
    setflag(FLAG_REMATCH_TALKED_JED)
    msgbox(format("JED: Ha... you probably remember us from CYCLING ROAD's end. LEA and I used to battle everyone in sight."))
    msgbox(format("LEX and I fell out over one battle. One! His TAUROS said my RAPIDASH false-started.\pRAPIDASH doesn't false-start. It's just fast."))
    msgbox(format("...Anyway. He's alright. We're going fishing next week, apparently."))
    release
    end
}
script Rematch_Garden_EventScript_Lea {
    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_LEA)) {
        msgbox(format("LEA: Look at them. Like they never stopped being friends."))
        release
        end
    }
    setflag(FLAG_REMATCH_TALKED_LEA)
    msgbox(format("LEA: JED practised his apology on me all week. He was so nervous he called NINETALES “Lex” twice."))
    msgbox(format("Funny, isn't it? All those battles, and what we really wanted was someone who loved their POKéMON as much as we loved ours.\pThey were right across the field the whole time."))
    release
    end
}
script Rematch_Garden_EventScript_Tauros {
    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_TAUROS)) {
        playmoncry(SPECIES_TAUROS, CRY_MODE_NORMAL)
        msgbox(format("TAUROS and RAPIDASH are touching noses. Nobody is false-starting."))
        waitmoncry
        release
        end
    }
    setflag(FLAG_REMATCH_TALKED_TAUROS)
    playmoncry(SPECIES_TAUROS, CRY_MODE_NORMAL)
    msgbox(format("TAUROS: Mooooh!\pIt snorts at RAPIDASH across the way... then wags its tails. Old rivals, new friends."))
    waitmoncry
    release
    end
}
