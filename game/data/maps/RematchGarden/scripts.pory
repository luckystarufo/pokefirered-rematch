// The reunion garden behind the café (layout generated by tools/rematch/garden/build_garden.py:
// SIX ISLAND plus an eastern valley). Old faces spend the evening here with their POKéMON.
// Nobody here battles: the only rematch of the night is the ELITE FOUR, in the tower (warp 1).
// The mood is nostalgia and making up: old rivals who finally shook hands.
// Doors marked "closed" get their interiors later (Pokémon Center, Mart, SABRINA, KOGA, LT. SURGE).

mapscripts RematchGarden_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_REMATCH_STATE, REMATCH_STATE_TRAVELLING: Rematch_Garden_EventScript_Welcome
    ]
}

// ---------------------------------------------------------------- the rival, right outside the café
// First time out of the café's back door (VAR_REMATCH_STATE still TRAVELLING): he walks up, teases,
// breaks down, explains the evening and gives you his last FULL RESTORE.
movement Rematch_Garden_Movement_Exclaim { emote_exclamation_mark delay_16 }
movement Rematch_Garden_Movement_RivalApproach { walk_down * 4 }
movement Rematch_Garden_Movement_RivalLookAway { face_left delay_16 delay_16 delay_16 face_right delay_16 delay_16 face_down }
movement Rematch_Garden_Movement_RivalStepAside { walk_left face_right }
movement Rematch_Garden_Movement_PlayerFaceUp { face_up }

script Rematch_Garden_EventScript_Welcome {
    lockall
    setvar(VAR_REMATCH_STATE, REMATCH_STATE_PARTY)
    applymovement(OBJ_EVENT_ID_PLAYER, Rematch_Garden_Movement_PlayerFaceUp)
    waitmovement(0)
    delay(30)
    playse(SE_PIN)
    applymovement(LOCALID_GARDEN_RIVAL, Rematch_Garden_Movement_Exclaim)
    waitmovement(0)
    playbgm(MUS_ENCOUNTER_RIVAL, 0)
    applymovement(LOCALID_GARDEN_RIVAL, Rematch_Garden_Movement_RivalApproach)
    waitmovement(0)
    msgbox(format("{RIVAL}: Well, well, well! Look who finally showed up!\pIt's been {YEARS_AGO} years, {PLAYER}! What, did you get lost on ROUTE 1 again?"))
    msgbox(format("And you still brought CHARIZARD? Figures. You never could let go of anything.\pSmell ya lat... no, wait. You just got here."))
    msgbox(format("..."))
    msgbox(format("...Hey. Don't look at me like that."))
    closemessage
    playbgm(MUS_SLOW_PALLET, 0)
    applymovement(LOCALID_GARDEN_RIVAL, Rematch_Garden_Movement_RivalLookAway)
    waitmovement(0)
    msgbox(format("{RIVAL}: Remember Gramps's lab? Three POKé BALLS on the table, and we nearly knocked it over fighting about who'd pick first.\pYou beat me at everything after that. Every single time."))
    msgbox(format("And then one day you just... weren't around anymore."))
    msgbox(format("...sniff...\pI-it's the sea breeze! Gets in your eyes out here!"))
    msgbox(format("...\pOkay. Okay, I'm fine. Listen up, {PLAYER}!"))
    playbgm(MUS_RIVAL_EXIT, 0)
    msgbox(format("Everybody came. Gramps and BLAINE are back in the café. The GYM LEADERS are all over this garden."))
    msgbox(format("And the ELITE FOUR are in the tall tower at the far end. Word is, they've got something planned for you."))
    msgbox(format("The CHEF's cooking up a feast for later. If your POKéMON need a rest, there's a POKéMON CENTER up the path."))
    msgbox(format("Oh, and... take this. Don't make it weird."))
    closemessage
    giveitem(ITEM_FULL_RESTORE)
    msgbox(format("{RIVAL}: Gramps gave me two of those before my League run. I used one in our battle for CHAMPION...\pI kept the other. Guess I was saving it for tonight.\pNow go on! Everybody's waiting for you."))
    closemessage
    applymovement(LOCALID_GARDEN_RIVAL, Rematch_Garden_Movement_RivalStepAside)
    waitmovement(0)
    setobjectxyperm(LOCALID_GARDEN_RIVAL, 10, 27)     // he stays by the door from now on
    setobjectmovementtype(LOCALID_GARDEN_RIVAL, MOVEMENT_TYPE_FACE_RIGHT)
    fadedefaultbgm
    releaseall
    end
}

script Rematch_Garden_EventScript_Rival {
    lock
    faceplayer
    msgbox(format("{RIVAL}: The GYM LEADERS are all over this garden. The ELITE FOUR are in the big tower at the far end.\pGo on, I'll catch up!"))
    release
    end
}

// ---------------------------------------------------------------- signs and doors
script Rematch_Garden_EventScript_GardenSign {
    msgbox(format("REUNION GARDEN"), MSGBOX_SIGN)
}
script Rematch_Garden_EventScript_PowerPlantSign {
    msgbox(format("POWER PLANT"), MSGBOX_SIGN)
}

// ---------------------------------------------------------------- the small tree in the beach fence
// Anyone can cut it: no badge or HM needed tonight.
script Rematch_Garden_EventScript_CutTree {
    lockall
    msgbox(format("A thin little tree is growing in the gap of the fence. Beyond it, you can hear waves.\pCut it down?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        releaseall
        end
    }
    msgbox(format("CHARIZARD sizes up the tree... and slices clean through it!"))
    closemessage
    playse(SE_M_CUT)
    setflag(FLAG_REMATCH_GARDEN_CUT_TREE)
    removeobject(LOCALID_GARDEN_CUT_TREE)
    waitse
    releaseall
    end
}

// ---------------------------------------------------------------- MISTY at the pond
script Rematch_Garden_EventScript_Misty {
    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_MISTY)) {
        msgbox(format("MISTY: Still no fish. STARYU says it's the pond's fault. I agree."))
        release
        end
    }
    setflag(FLAG_REMATCH_TALKED_MISTY)
    setvar(VAR_0x8009, FAMECHECKER_MISTY)   // their page in the FAME CHECKER
    special(Rematch_UnlockFamePage)
    msgbox(format("MISTY: Shh! STARYU almost had a fish!\p...Oh! It's you! You actually came!"))
    msgbox(format("You know what I remember? You marching into my GYM like you owned the place.\pI was so mad afterwards, I made my trainers swim extra laps for a whole week."))
    msgbox(format("Truth is, I trained harder after you left than I ever had before.\pSo... thanks, I guess. Don't let it go to your head."))
    msgbox(format("Here. Water from CERULEAN, for that LAPRAS of yours."))
    giveitem(ITEM_MYSTIC_WATER)
    msgbox(format("And don't tell anyone I was being nice."))
    msgbox(format("They promised me a lake, by the way. This is a pond. A pond with ambition."))
    release
    end
}
script Rematch_Garden_EventScript_Psyduck {
    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_PSYDUCK)) {
        playmoncry(SPECIES_PSYDUCK, CRY_MODE_NORMAL)
        msgbox(format("PSYDUCK is still standing here. It's forgotten why again."))
        waitmoncry
        release
        end
    }
    setflag(FLAG_REMATCH_TALKED_PSYDUCK)
    playmoncry(SPECIES_PSYDUCK, CRY_MODE_NORMAL)
    msgbox(format("PSYDUCK: Psy...?\pIt's holding its head. It seems to have forgotten why it walked over here."))
    waitmoncry
    release
    end
}
script Rematch_Garden_EventScript_Starmie {
    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_STARMIE)) {
        playmoncry(SPECIES_STARMIE, CRY_MODE_NORMAL)
        msgbox(format("STARMIE spins once, showing off. Its core glows a steady blue."))
        waitmoncry
        release
        end
    }
    setflag(FLAG_REMATCH_TALKED_STARMIE)
    playmoncry(SPECIES_STARMIE, CRY_MODE_NORMAL)
    msgbox(format("STARMIE: Hyah!\pIts core flickers red, then blue. It definitely remembers you... and it doesn't seem to hold a grudge."))
    waitmoncry
    release
    end
}
script Rematch_Garden_EventScript_Staryu {
    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_STARYU)) {
        playmoncry(SPECIES_STARYU, CRY_MODE_NORMAL)
        msgbox(format("STARYU has stopped spinning. It seems to be watching the sunset too."))
        waitmoncry
        release
        end
    }
    setflag(FLAG_REMATCH_TALKED_STARYU)
    playmoncry(SPECIES_STARYU, CRY_MODE_NORMAL)
    msgbox(format("STARYU is spinning slowly in the water, catching the last of the sunlight."))
    waitmoncry
    release
    end
}

// ---------------------------------------------------------------- BROCK in the rocky hollow
script Rematch_Garden_EventScript_Brock {
    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_BROCK)) {
        msgbox(format("BROCK: Careful on those stairs. I'm almost a doctor, not quite one yet."))
        release
        end
    }
    call(Rematch_Garden_EventScript_Brock_FirstTalk)
    release
    end
}

script Rematch_Garden_EventScript_Brock_FirstTalk {
    setflag(FLAG_REMATCH_TALKED_BROCK)
    setvar(VAR_0x8009, FAMECHECKER_BROCK)   // their page in the FAME CHECKER
    special(Rematch_UnlockFamePage)
    msgbox(format("BROCK: Hey! Watch your step on the way down, those stairs are older than both of us.\pIt's good to see you, {PLAYER}. Really good."))
    msgbox(format("You know, you're the trainer who made ONIX lose its cool. A little CHARMANDER against a mountain of rock... I still don't know how you pulled it off."))
    msgbox(format("I'm studying to be a POKéMON doctor now.\pFunny. Healing turned out to be harder than any GYM battle ever was."))
    msgbox(format("Here, take this. Doctor's orders."))
    giveitem(ITEM_MAX_REVIVE)
    msgbox(format("Keep it for when it really counts. I hope you never need it."))
    msgbox(format("ONIX found this hollow the moment we arrived. It says it smells like PEWTER."))
    closemessage
    return
}
script Rematch_Garden_EventScript_Onix {
    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_ONIX)) {
        playmoncry(SPECIES_ONIX, CRY_MODE_NORMAL)
        msgbox(format("ONIX has curled up in the hollow, rumbling softly like a far-off rockslide."))
        waitmoncry
        release
        end
    }
    setflag(FLAG_REMATCH_TALKED_ONIX)
    playmoncry(SPECIES_ONIX, CRY_MODE_NORMAL)
    msgbox(format("ONIX: Gorooo...\pIt lowers its enormous head so you can pat it. The rocks are warm from the sun."))
    waitmoncry
    release
    end
}
script Rematch_Garden_EventScript_Geodude {
    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_GEODUDE)) {
        playmoncry(SPECIES_GEODUDE, CRY_MODE_NORMAL)
        msgbox(format("GEODUDE is still doing push-ups. You're starting to feel lazy."))
        waitmoncry
        release
        end
    }
    setflag(FLAG_REMATCH_TALKED_GEODUDE)
    playmoncry(SPECIES_GEODUDE, CRY_MODE_NORMAL)
    msgbox(format("GEODUDE is doing push-ups.\pIt has been doing push-ups since you arrived. It shows no sign of stopping."))
    waitmoncry
    release
    end
}

// ---------------------------------------------------------------- ERIKA between the fountains
script Rematch_Garden_EventScript_Erika {
    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_ERIKA)) {
        msgbox(format("ERIKA: ...Zzz... Mm... VILEPLUME, a little less pollen, please..."))
        release
        end
    }
    setflag(FLAG_REMATCH_TALKED_ERIKA)
    setvar(VAR_0x8009, FAMECHECKER_ERIKA)   // their page in the FAME CHECKER
    special(Rematch_UnlockFamePage)
    msgbox(format("ERIKA: ...Mm? Oh my. I must have dozed off among the flowers again.\pForgive me. The fountains are so soothing."))
    msgbox(format("{PLAYER}... Goodness, you've grown so tall. For a moment I took you for one of my trees."))
    msgbox(format("Is that CHARIZARD? It once singed my VILEPLUME's petals, you know.\pThey grew back twice as lovely. Please tell it I forgave it long ago."))
    msgbox(format("Oh, and do look at the young couples over there. They quarrelled for ages, I hear.\pThey made up right here, beside my VILEPLUME. I like to think the flowers helped."))
    release
    end
}
