    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_VILEPLUME)) {
        playmoncry(SPECIES_VILEPLUME, CRY_MODE_NORMAL)
        msgbox(format("VILEPLUME sways. You decide not to stand downwind this time."))
        waitmoncry
        release
        end
    }
    setflag(FLAG_REMATCH_TALKED_VILEPLUME)
    playmoncry(SPECIES_VILEPLUME, CRY_MODE_NORMAL)
    msgbox(format("VILEPLUME: Plooo...\pA sweet, drowsy scent drifts from its petals. Your eyelids feel heavy..."))
    waitmoncry
    release
    end
}
