        end
    }
    setflag(FLAG_REMATCH_TALKED_MILTANK)
    playmoncry(SPECIES_MILTANK, CRY_MODE_NORMAL)
    msgbox(format("MILTANK: Moooo!\pIt looks very proud of itself. You've never seen one of these in KANTO before."))
    waitmoncry
    release
    end
}
script Rematch_Garden_EventScript_Rapidash {
    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_RAPIDASH)) {
        playmoncry(SPECIES_RAPIDASH, CRY_MODE_NORMAL)
        msgbox(format("RAPIDASH's mane flickers a little brighter as you come close."))
        waitmoncry
        release
        end
    }
    setflag(FLAG_REMATCH_TALKED_RAPIDASH)
    playmoncry(SPECIES_RAPIDASH, CRY_MODE_NORMAL)
    msgbox(format("RAPIDASH: Hihiiin!\pIts mane is burning very low and very carefully. It doesn't want to singe ERIKA's garden."))
    waitmoncry
    release
    end
}
script Rematch_Garden_EventScript_Ninetales {
    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_NINETALES)) {
        playmoncry(SPECIES_NINETALES, CRY_MODE_NORMAL)
        msgbox(format("NINETALES has wrapped its tails around itself like a blanket."))
        waitmoncry
        release
        end
    }
    setflag(FLAG_REMATCH_TALKED_NINETALES)
    playmoncry(SPECIES_NINETALES, CRY_MODE_NORMAL)
    msgbox(format("NINETALES gazes at you with calm red eyes.\pIts nine tails sway together like they're keeping time to music only it can hear."))
    waitmoncry
    release
    end
}

// ---------------------------------------------------------------- the MEGA PUNCH / MEGA KICK tutors
// They stood three steps apart outside MT. MOON for years, each insisting his move was better.
script Rematch_Garden_EventScript_MegaPunch {
    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_MEGA_PUNCH)) {
        msgbox(format("A fist and a foot! Remember that, friend. It'll be on the DOJO sign."))
        release
        end
    }
    setflag(FLAG_REMATCH_TALKED_MEGA_PUNCH)
    msgbox(format("Hah! A visitor! Wait... I know you! The trainer who walked past us outside MT. MOON!\pI wanted to teach you MEGA PUNCH. HE wanted to teach you MEGA KICK."))
    msgbox(format("We argued about it for years. Punch or kick. Kick or punch.\pThen one day HITMONCHAN and HITMONLEE started sparring together... and they were stronger as a pair than either one alone."))
    msgbox(format("So here we are. Partners! A fist and a foot. We're thinking of opening a DOJO."))
    release
    end
}
script Rematch_Garden_EventScript_MegaKick {
    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_MEGA_KICK)) {
        msgbox(format("Kick and punch. Punch and kick. ...We still argue about the order on the sign."))
        release
        end
    }
    setflag(FLAG_REMATCH_TALKED_MEGA_KICK)
    msgbox(format("We used to stand three steps apart and shout at each other all day.\pNow we stand three steps apart and shout ENCOURAGEMENT at each other. Huge improvement!"))
    msgbox(format("If you'd come to me first back then, you'd know: a great kick starts in the heart.\pAnd so does a great punch. He finally convinced me of that."))
    release
    end
}
script Rematch_Garden_EventScript_Hitmonchan {
    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_HITMONCHAN)) {
        playmoncry(SPECIES_HITMONCHAN, CRY_MODE_NORMAL)
        msgbox(format("HITMONCHAN is cooling down. It bows to you again, just as politely."))
        waitmoncry
        release
        end
    }
    setflag(FLAG_REMATCH_TALKED_HITMONCHAN)
    playmoncry(SPECIES_HITMONCHAN, CRY_MODE_NORMAL)
    msgbox(format("HITMONCHAN throws a quick one-two at the air, then bows to you politely."))
    waitmoncry
    release
    end
}
script Rematch_Garden_EventScript_Hitmonlee {
    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_HITMONLEE)) {
        playmoncry(SPECIES_HITMONLEE, CRY_MODE_NORMAL)
        msgbox(format("HITMONLEE is now stretching the OTHER leg. Even higher."))
        waitmoncry
        release
        end
    }
    setflag(FLAG_REMATCH_TALKED_HITMONLEE)
    playmoncry(SPECIES_HITMONLEE, CRY_MODE_NORMAL)
    msgbox(format("HITMONLEE stretches one leg impossibly high.\pIt's definitely showing off for HITMONCHAN."))
    waitmoncry
    release
    end
}

// ---------------------------------------------------------------- on the beach
script Rematch_Garden_EventScript_FishingGuru {
    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_FISHING_GURU)) {
        msgbox(format("MAGIKARP. Always MAGIKARP. I wouldn't change a thing."))
        release
        end
    }
    setflag(FLAG_REMATCH_TALKED_FISHING_GURU)
    msgbox(format("Shhh! Fish can hear footsteps, you know.\p...Hm? Wait a moment. You're the youngster I gave that OLD ROD to, back in VERMILION!"))
    msgbox(format("Let me guess what you caught first. A MAGIKARP.\pEveryone's first catch is a MAGIKARP. And everyone remembers it. That's the beauty of fishing!"))
    msgbox(format("My little brother's down on the beach. He used to out-fish all of us.\pHasn't cast a line since his first kid was born. Says the fish can wait."))
    release
    end
}
// His brother, the GOOD ROD guru from FUCHSIA: a dad now, and done with fishing.
script Rematch_Garden_EventScript_FishingBrother {
    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_FISHING_BROTHER)) {
        msgbox(format("NOT TOO FAR, you two! ...Sorry. Habit."))
        release
        end
    }
    setflag(FLAG_REMATCH_TALKED_FISHING_BROTHER)
    msgbox(format("Oh, hello! You look familiar... FUCHSIA! I gave you a GOOD ROD once, didn't I?"))
    msgbox(format("See those two splashing out there? Mine. I hung up my rod the day they were born.\pThese days the only thing I reel in is a kid who swam out too far."))
    msgbox(format("My big brother's up on the old landing past the POKéMON CENTER, still at it.\pTell him I said his MAGIKARP story gets bigger every year."))
    release
    end
}
// The GOOD ROD brother's kids (their uncle is the FISHING GURU on the landing).
script Rematch_Garden_EventScript_TuberBoy {
    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_TUBER_BOY)) {
        msgbox(format("Watch! I'm floating! ...Is Dad watching?"))
        release
        end
    }
    setflag(FLAG_REMATCH_TALKED_TUBER_BOY)
    msgbox(format("Look! Look! I can float without kicking!"))
    msgbox(format("Dad says he used to be the best fisherman in KANTO.\pNow he just yells “NOT TOO FAR!” all day."))
    release
    end
}
script Rematch_Garden_EventScript_TuberGirl {
    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_TUBER_GIRL)) {
        msgbox(format("That's ONE! ...Oh. It's seaweed."))
        release
        end
    }
    setflag(FLAG_REMATCH_TALKED_TUBER_GIRL)
    msgbox(format("I'm gonna catch a GYARADOS when I grow up!"))
    msgbox(format("Uncle says first you have to catch a hundred MAGIKARP.\pI've caught... zero. But I'm really close!"))
    release
    end
}

// The CERULEAN bike shop owner and a CYCLING ROAD biker. The bikers used to roar up and down the
// road scaring cyclists; now the biker is the shop's best customer.
script Rematch_Garden_EventScript_BikeShop {
    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_BIKE_SHOP)) {
        msgbox(format("Every BICYCLE has a price. Tonight, yours was a smile. Worth a million."))
        release
        end
    }
    setflag(FLAG_REMATCH_TALKED_BIKE_SHOP)
    msgbox(format("Well, if it isn't my most famous customer!\pYou walked into my shop with a BIKE VOUCHER and rode out on my finest model. Didn't pay a single coin!"))
    msgbox(format("Everyone said a million for a BICYCLE was madness.\pThey were right, of course. But nobody ever forgot my shop, did they?"))
    msgbox(format("But tonight... no vouchers, and no prices.\pThis is the best BICYCLE I've ever built. I finished it this morning, just for you."))
    giveitem(ITEM_BICYCLE)
    msgbox(format("Ride it like it's {PLAY_YEAR} again!"))
    release
    end
}
script Rematch_Garden_EventScript_Biker {
    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_BIKER)) {
        msgbox(format("These days I ride a BICYCLE. Don't laugh. ...Okay, you can laugh a little."))
        release
        end
    }
    call(Rematch_Garden_EventScript_Biker_FirstTalk)
    release
    end
}

script Rematch_Garden_EventScript_Biker_FirstTalk {
    setflag(FLAG_REMATCH_TALKED_BIKER)
    msgbox(format("Yo. Relax, I ain't here to rumble.\pBack in the day, my gang ruled CYCLING ROAD. Revving engines, cutting off every kid on a BICYCLE... you included, probably."))
    closemessage
    return
}


// ---------------------------------------------------------------- walk-ups in the garden
// BROCK: the first time you step onto the stairs down into his hollow (27,27 / 28,27), he comes to the foot
// of the stairs, talks, and goes back to ONIX. The BIKER, parked on the beach, rides up the first time you
// reach the beach (through the gap by the cut tree, 68,27, or up the sand path, 40-42,30).
movement Rematch_Garden_Movement_BrockTo27 { emote_exclamation_mark walk_up walk_left * 2 face_up }
movement Rematch_Garden_Movement_BrockBackFrom27 { walk_right * 2 walk_down face_right }
movement Rematch_Garden_Movement_BrockTo28 { emote_exclamation_mark walk_up walk_left face_up }
movement Rematch_Garden_Movement_BrockBackFrom28 { walk_right walk_down face_right }
movement Rematch_Garden_Movement_PlayerFaceDown { face_down }
movement Rematch_Garden_Movement_PlayerFaceLeft { face_left }

script Rematch_Garden_EventScript_BrockAtStairs {
    setvar(VAR_TEMP_2, 1)
    if (flag(FLAG_REMATCH_TALKED_BROCK)) {
        end
    }
    lockall
    getplayerxy(VAR_0x8004, VAR_0x8005)
    applymovement(OBJ_EVENT_ID_PLAYER, Rematch_Garden_Movement_PlayerFaceDown)
    if (var(VAR_0x8004) == 27) {
        applymovement(LOCALID_GARDEN_BROCK, Rematch_Garden_Movement_BrockTo27)
    } else {
        applymovement(LOCALID_GARDEN_BROCK, Rematch_Garden_Movement_BrockTo28)
    }
    waitmovement(0)
    call(Rematch_Garden_EventScript_Brock_FirstTalk)
    getplayerxy(VAR_0x8004, VAR_0x8005)
    if (var(VAR_0x8004) == 27) {
        applymovement(LOCALID_GARDEN_BROCK, Rematch_Garden_Movement_BrockBackFrom27)
    } else {
        applymovement(LOCALID_GARDEN_BROCK, Rematch_Garden_Movement_BrockBackFrom28)
    }
    waitmovement(0)
    releaseall
    end
}

// The BIKER is parked at 60,28.
movement Rematch_Garden_Movement_BikerToGap { walk_fast_right * 7 walk_fast_up face_right }
movement Rematch_Garden_Movement_BikerBackFromGap { walk_down walk_left * 7 face_left }
movement Rematch_Garden_Movement_BikerTo40 { walk_fast_left * 20 walk_fast_down face_down }
movement Rematch_Garden_Movement_BikerBackFrom40 { walk_up walk_right * 20 face_left }
movement Rematch_Garden_Movement_BikerTo41 { walk_fast_left * 19 walk_fast_down face_down }
movement Rematch_Garden_Movement_BikerBackFrom41 { walk_up walk_right * 19 face_left }
movement Rematch_Garden_Movement_BikerTo42 { walk_fast_left * 18 walk_fast_down face_down }
movement Rematch_Garden_Movement_BikerBackFrom42 { walk_up walk_right * 18 face_left }
movement Rematch_Garden_Movement_PlayerFaceUpAgain { face_up }

script Rematch_Garden_EventScript_BikerRollsUp {
    setvar(VAR_TEMP_3, 1)
    if (flag(FLAG_REMATCH_TALKED_BIKER)) {
        end
    }
    lockall
    getplayerxy(VAR_0x8004, VAR_0x8005)
    playse(SE_BIKE_BELL)
    if (var(VAR_0x8005) == 27) {
        applymovement(OBJ_EVENT_ID_PLAYER, Rematch_Garden_Movement_PlayerFaceLeft)
        applymovement(LOCALID_GARDEN_BIKER, Rematch_Garden_Movement_BikerToGap)
    } elif (var(VAR_0x8004) == 40) {
        applymovement(OBJ_EVENT_ID_PLAYER, Rematch_Garden_Movement_PlayerFaceUpAgain)
        applymovement(LOCALID_GARDEN_BIKER, Rematch_Garden_Movement_BikerTo40)
    } elif (var(VAR_0x8004) == 41) {
        applymovement(OBJ_EVENT_ID_PLAYER, Rematch_Garden_Movement_PlayerFaceUpAgain)
        applymovement(LOCALID_GARDEN_BIKER, Rematch_Garden_Movement_BikerTo41)
    } else {
        applymovement(OBJ_EVENT_ID_PLAYER, Rematch_Garden_Movement_PlayerFaceUpAgain)
        applymovement(LOCALID_GARDEN_BIKER, Rematch_Garden_Movement_BikerTo42)
    }
    waitmovement(0)
    call(Rematch_Garden_EventScript_Biker_FirstTalk)
    if (var(VAR_0x8005) == 27) {
        applymovement(LOCALID_GARDEN_BIKER, Rematch_Garden_Movement_BikerBackFromGap)
    } elif (var(VAR_0x8004) == 40) {
        applymovement(LOCALID_GARDEN_BIKER, Rematch_Garden_Movement_BikerBackFrom40)
    } elif (var(VAR_0x8004) == 41) {
        applymovement(LOCALID_GARDEN_BIKER, Rematch_Garden_Movement_BikerBackFrom41)
    } else {
        applymovement(LOCALID_GARDEN_BIKER, Rematch_Garden_Movement_BikerBackFrom42)
    }
    waitmovement(0)
    releaseall
    end
}
