    setflag(FLAG_REMATCH_TALKED_GENGAR)
    playmoncry(SPECIES_GENGAR, CRY_MODE_NORMAL)
    msgbox(format("GENGAR: Gengar!\pIt grins. You feel a chill... and a little nostalgic."))
    waitmoncry
    release
    end
}

script Rematch_Arena_EventScript_Dragonite {
    lock
    faceplayer
    if (flag(FLAG_REMATCH_TALKED_DRAGONITE)) {
        playmoncry(SPECIES_DRAGONITE, CRY_MODE_NORMAL)
        msgbox(format("DRAGONITE bows again, a little lower this time."))
        waitmoncry
        release
        end
    }
    setflag(FLAG_REMATCH_TALKED_DRAGONITE)
    playmoncry(SPECIES_DRAGONITE, CRY_MODE_NORMAL)
    msgbox(format("DRAGONITE: Grooo!\pIt bows its big head politely."))
    waitmoncry
    release
    end
}
