# ---------------------------------------------------------------
# LEGAL GUARDRAIL: never commit ROMs, saves, or save states.
# The built ROM only ever lives in a private S3 bucket.
# ---------------------------------------------------------------
*.gba
*.gb
*.gbc
*.agb
*.srl
*.bin.gba
baserom*
*.sav
*.srm
*.ss[0-9]
*.state
*.sgm

# Build outputs
build/
dist/
cdk.out/
*.elf
*.map

# Node
node_modules/
npm-debug.log*

# Secrets / local config
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.vscode/
.idea/

# Rematch: tool binaries copied in by tools/rom-builder/entrypoint.sh
game/tools/poryscript/poryscript
# Rematch: Poryscript output (generated from the .pory next to it)
game/data/scripts/rematch/*.inc
game/data/maps/Rematch*/scripts.inc
# Rematch: build output (regenerated by make)
game/rom-manifest.json

# Rematch web + AWS: host-only settings, invites, messages, secrets (never published)
.local/
# copied in by web/sync-rom.sh (the ROM) and tools/fetch-web-vendor.sh (EmulatorJS, font)
web/rom/
web/emulator/
web/fonts/
